# 后端环境变量示例
# 复制为 .env 后修改真实值

# DeepSeek / LLM
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# SiliconFlow / Embedding
SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDER_MODEL=BAAI/bge-m3

# Oracle 26ai（关系表 + AI Vector Search 同库，FREEPDB1 / DEVUSER）
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_USER=DEVUSER
ORACLE_PASSWORD=DevPassword123
ORACLE_SERVICE=FREEPDB1

# 兼容旧引用（mem0 history_store 使用 PG 时保留，可忽略）
DB_HOST=localhost
DB_PORT=5432
DB_USER=memuser
DB_PASSWORD=mempassword
DB_NAME=agent_memory

# Kafka / Redis
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_URL=redis://localhost:6379/0

# Internal OpenMemory MCP used by backend storage compatibility path
MCP_BASE_URL=http://127.0.0.1:8765/mcp

# Security / app
SECRET_KEY=change-this-secret-key
AUTH_ENABLED=false
JWT_SECRET_KEY=change-this-jwt-secret
LOG_LEVEL=INFO

# memProject MCP Server
MEMPROJECT_API_URL=http://127.0.0.1:8000
