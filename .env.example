# 统一环境变量示例（前后端 + 基础设施）
# 复制为 .env 后修改真实值即可。
# 适用于 root docker-compose.yml 中的容器编排。

# ---------- 基础设施 ----------
POSTGRES_USER=memuser
POSTGRES_PASSWORD=mempassword
POSTGRES_DB=agent_memory

DB_HOST=postgres
DB_PORT=5432
DB_USER=memuser
DB_PASSWORD=mempassword
DB_NAME=agent_memory

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

KAFKA_BOOTSTRAP_SERVERS=kafka:9093
KAFKA_PORT=9092
KAFKA_UI_PORT=8080

MCP_BASE_URL=http://openmemory:8765/mcp
OPENMEMORY_PORT=8765

# ---------- LLM / Embedding ----------
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDER_MODEL=BAAI/bge-m3

# ---------- 应用通用 ----------
SECRET_KEY=change-this-secret-key
AUTH_ENABLED=false
JWT_SECRET_KEY=change-this-jwt-secret
LOG_LEVEL=INFO

# ---------- 前端 ----------
VITE_API_BASE_URL=http://localhost:8000
VITE_API_TIMEOUT_MS=30000
VITE_APP_TITLE=智能体记忆系统前端

# ---------- 端口 ----------
POSTGRES_PORT=5433
FRONTEND_PORT=8081
BACKEND_PORT=8000
