# 统一环境变量示例（前后端 + 基础设施）
# 复制为 .env 后修改真实值即可。
# 适用于 root docker-compose.yml 中的容器编排。

# ---------- Oracle 26ai ----------
# 关系表 + AI Vector Search 同库，指向已部署的 Oracle 26ai Free。
# 宿主机/容器内都需要能路由到该地址；若 Oracle 在本地，请使用本机可路由 IP。
ORACLE_HOST=127.0.0.1
ORACLE_PORT=1521
ORACLE_USER=DEVUSER
ORACLE_PASSWORD=DevPassword123
ORACLE_SERVICE=FREEPDB1

# ---------- 消息队列 / 缓存 ----------
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

KAFKA_BOOTSTRAP_SERVERS=kafka:9093
KAFKA_PORT=9092
KAFKA_UI_PORT=8080

# ---------- 内部 REST 自调地址 ----------
# backend 内置 MCP 工具通过该地址调用自身 REST API；容器内使用 127.0.0.1:8000。
BACKEND_REST_URL=http://127.0.0.1:8000

# ---------- LLM / Embedding ----------
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDER_MODEL=BAAI/bge-m3

# ---------- 应用通用 ----------
SECRET_KEY=change-this-secret-key
AUTH_ENABLED=false
JWT_SECRET_KEY=change-this-jwt-secret
LOG_LEVEL=INFO
TZ=Asia/Shanghai

# ---------- 前端 ----------
VITE_API_BASE_URL=http://localhost:8000
VITE_API_TIMEOUT_MS=30000
VITE_APP_TITLE=智能体记忆系统前端

# ---------- 端口 ----------
FRONTEND_PORT=8081
BACKEND_PORT=8000
