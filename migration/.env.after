# ============================================================
# .env（迁移后参考样例）—— PostgreSQL+Qdrant -> Oracle 26ai (AI Vector Search)
# 复制到仓库根 .env 前请替换真实密钥。
# ============================================================

# ---------- 数据库：Oracle 26ai（关系表 + AI Vector Search 同库） ----------
ORACLE_HOST=127.0.0.1
ORACLE_PORT=1521
ORACLE_USER=DEVUSER
ORACLE_PASSWORD=DevPassword123
ORACLE_SERVICE=FREEPDB1
# 容器内访问宿主机用 host.docker.internal（compose 已配 extra_hosts）

# ---------- Redis（Kafka 降级/结果回调用） ----------
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PORT=6379

# ---------- Kafka（可选；不可用时 write 自动降级同步落 L0） ----------
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_PORT=9092
KAFKA_UI_PORT=8080

# ---------- LLM / Embedding ----------
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDER_MODEL=BAAI/bge-m3

# ---------- 应用通用 ----------
SECRET_KEY=change-this-secret-key
AUTH_ENABLED=false
JWT_SECRET_KEY=change-this-jwt-secret
LOG_LEVEL=INFO

# ---------- 前端 ----------
VITE_API_BASE_URL=http://localhost:8000
VITE_API_TIMEOUT_MS=30000
VITE_APP_TITLE=智能体记忆系统前端

# ---------- 端口 ----------
FRONTEND_PORT=8081
BACKEND_PORT=8000
